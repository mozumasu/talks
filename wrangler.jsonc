{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "talks",
  "main": "./worker.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "talks.mozumasu.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
